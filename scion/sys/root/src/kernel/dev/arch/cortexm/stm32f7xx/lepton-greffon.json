{
  "nom": "stm32f7xx",
  "type": "famille",
  "version": "1.0.0",
  "description": "Famille STM32F7 : couche Lepton (USART, Ethernet, tick de la HAL), HAL ST STM32CubeF7 1.17.4 (hal_driver), CMSIS device ST STM32F7xx (cmsis-5). Seuls les fichiers listés dans sources sont compilés ; stm32f7xx_hal_conf.h est fourni par le BSP.",
  "destination": "kernel/dev/arch/cortexm/stm32f7xx",
  "bibliotheque": "kernel",
  "sources": [
    "dev_stm32f7xx/dev_stm32f7xx_uart_x.c",
    "dev_stm32f7xx/dev_stm32f7xx_eth_x.c",
    "dev_stm32f7xx/dev_stm32f7xx_hal_tick.c",
    "hal_driver/Src/stm32f7xx_hal_gpio.c",
    "hal_driver/Src/stm32f7xx_hal_eth.c",
    "hal_driver/Src/stm32f7xx_hal_rcc.c",
    "hal_driver/Src/stm32f7xx_hal_cortex.c"
  ],
  "dependances": [
    "lepton-noyau"
  ],
  "coeurs": [
    "cortex-m7"
  ],
  "mcu": [
    "STM32F746xx"
  ],
  "compilation": {
    "publique": {
      "definitions": [
        "USE_HAL_DRIVER"
      ],
      "inclusions": [
        "kernel/dev/arch/cortexm/stm32f7xx/dev_stm32f7xx",
        "kernel/dev/arch/cortexm/stm32f7xx/hal_driver/Inc",
        "kernel/core/ucore/cmsis-5/Device/ST/STM32F7xx/Include"
      ]
    }
  }
}
